{
  "name": "gatekeep",
  "version": "2.0.0",
  "description": "Secure file delivery with receipts, self-hosted: send files to named recipients (email codes or passwords), see every open and download, and take access back. Next.js + Supabase.",
  "keywords": [
    "file-delivery",
    "secure-file-sharing",
    "self-hosted",
    "file-requests",
    "audit-log",
    "access-control",
    "nextjs",
    "supabase"
  ],
  "homepage": "https://gatekeep.omsingh.me",
  "bugs": {
    "url": "https://github.com/omsingh02/gatekeep/issues"
  },
  "author": "Om Singh (https://github.com/omsingh02)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omsingh02/gatekeep.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "create-admin": "node scripts/create-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e": "playwright test",
    "brand-assets": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "bcryptjs": "^3.0.3",
    "client-zip": "^2.5.1",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.16",
    "next": "16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
