# Gatekeep configuration. Copy to .env.local (development) or .env (Docker), or set these in your
# host's dashboard (Vercel: Project → Settings → Environment Variables). See docs/DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Supabase (required): Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key: server-side only, full database access. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# App (required)
# ---------------------------------------------------------------------------
# Public base URL, used in delivery links, emails and password reset links. No trailing slash.
# Production: your domain (https://files.example.com). Development: http://localhost:3000
# Docker: inlined into the browser bundle at build time, so rebuild after changing it.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ---------------------------------------------------------------------------
# Owner (required on instances upgraded from 1.x)
# ---------------------------------------------------------------------------
# Only the owner can use the dashboard and owner APIs. `npm run create-admin` marks the account it
# creates as the owner, so new installs can leave this empty. Otherwise list the owner's sign-in
# email(s), comma-separated.
OWNER_EMAILS=

# ---------------------------------------------------------------------------
# Daily job (required in production)
# ---------------------------------------------------------------------------
# Authenticates /api/cron/keep-alive (vercel.json, or the Docker `cron` service): keeps a free
# Supabase project awake, sends "access ends soon" reminders and purges old email codes.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Email (recommended): https://resend.com
# ---------------------------------------------------------------------------
# Sends invites, email codes, your notifications (opened, downloaded, denied, uploaded) and
# password resets. Without both, recipients sign in with passwords only.
RESEND_API_KEY=
# A sender on a domain verified in Resend. Emails appear as "{your name} via Gatekeep",
# and replies go to you.
EMAIL_FROM=Gatekeep <noreply@your-domain.com>

# Time zone for dates in emails (IANA name, e.g. Europe/London). Default: UTC.
GATEKEEP_TIMEZONE=

# Development and tests only (never in production): EMAIL_TRANSPORT=memory keeps emails in the
# server process, and E2E_TEST_SUPPORT=1 exposes them to the end-to-end tests. See CONTRIBUTING.md.
