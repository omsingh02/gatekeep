# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-side only - NEVER expose to client)
# This has admin privileges - keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App Configuration
# Use your production domain for Vercel, localhost for development
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Email notifications (optional) - https://resend.com
# When unset, access grants still work but no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Gatekeep <noreply@your-domain.com>

# Daily keep-alive cron (vercel.json) - Vercel sends it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=
