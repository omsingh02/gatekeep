# Local demo environment (see docs/SCREENSHOTS.md).
# `npm run seed:demo` and `npm run screenshots` read these from `npx supabase status -o env`
# automatically, so you only need this file to override something. Copy to .env.demo to use it.

# From `npx supabase status -o env` (API_URL, ANON_KEY, SERVICE_ROLE_KEY) — local dev keys, not secrets
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the demo app runs
NEXT_PUBLIC_APP_URL=http://localhost:3302

# Headless browser used for demo assets and screenshots
CHROMIUM_PATH=/usr/bin/chromium
